# bishop-memory integration for this harness.
#
# Copy this file to .opencode/bishop-memory.conf and edit it. The live file is
# gitignored, so each harness clone carries its own identity rather than
# inheriting a committed one.

# standalone — the harness owns its memory entirely. No network calls, mission
#              IDs derived locally from folders and logs. bishop-memory does not
#              need to be installed. This is the default, and is also what
#              applies when this file is absent.
# central    — mission IDs are allocated by bishop-memory so they are unique
#              across every harness, and journal rows are mirrored to it.
BISHOP_MEMORY_MODE=standalone

# Base URL of the bishop-memory HTTP API.
BISHOP_MEMORY_URL=http://127.0.0.1:8787

# This harness's identity. MUST be unique per harness — it is what stops two
# harnesses colliding on a mission ID. Keep it identical to BISHOP_HARNESS in
# the bishop-memory MCP server registration so agent identity and mission
# ownership agree. Required in central mode.
BISHOP_HARNESS=

# Path to the bishop-memory checkout directory (the folder that contains
# bin/mcpd). Optional: if left empty, the connect script falls back to the
# BISHOP_MEMORY_HOME environment variable, then to a sibling checkout of this
# harness repo (<parent-of-this-repo>/bishop-memory).
# BISHOP_MEMORY_HOME=
